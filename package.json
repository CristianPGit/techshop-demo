{
  "name": "techshop-demo",
  "version": "1.0.0",
  "description": "Demo e-commerce site for AI for QA Course — Modules 2 & 3",
  "scripts": {
    "start": "npx serve . -p 3000",
    "test": "npx playwright test",
    "test:module2": "npx playwright test tests/module2.spec.js",
    "test:module3": "npx playwright test tests/module3.spec.js",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:update-snapshots": "npx playwright test tests/module3.spec.js --update-snapshots",
    "test:report": "npx playwright show-report",
    "autofix": "node scripts/autofix-agent.js",
    "visual-diff": "node scripts/ai-visual-diff.js",
    "bug-report": "node scripts/create-bug-report.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "serve": "^14.2.3"
  },
  "engines": {
    "node": ">=18"
  }
}
