<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:x="urn:schemas-microsoft-com:office:excel">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Top"/>
   <Font ss:FontName="Calibri" ss:Size="11"/>
  </Style>
  <Style ss:ID="hdr">
   <Alignment ss:Vertical="Center" ss:Horizontal="Left"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#2F5496" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="body">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D9D9D9"/>
   </Borders>
  </Style>
 </Styles>
 <Worksheet ss:Name="TRI-15 Test Cases">
  <Table>
   <Column ss:Width="90"/><Column ss:Width="40"/><Column ss:Width="70"/><Column ss:Width="220"/><Column ss:Width="320"/><Column ss:Width="360"/><Column ss:Width="60"/>
   <Row ss:Height="22"><Cell ss:StyleID="hdr"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="hdr"><Data ss:Type="String">AC</Data></Cell><Cell ss:StyleID="hdr"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="hdr"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="hdr"><Data ss:Type="String">Steps</Data></Cell><Cell ss:StyleID="hdr"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="hdr"><Data ss:Type="String">Pass/Fail</Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC1-01</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC1</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Logged-in shopper, item in cart, FX API up, 32 currencies configured</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Go to checkout.&#10;2. Open currency dropdown.&#10;3. Select a non-base currency (e.g., EUR).</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Dropdown lists all 32 supported currencies; selection accepted and reflected in checkout UI; totals re-render in EUR.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC1-02</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC1</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Checkout page, currency dropdown present</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Reach checkout without choosing a currency.&#10;2. Attempt to place the order.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">If no default applies, order is blocked with a clear 'select a currency' prompt; if base default applies, it is shown explicitly — no silent/empty currency on the order.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC1-03</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC1</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Negative / Out-of-scope</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Checkout page; attempt unsupported/invalid currency</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Via tampered request/URL param, submit an unsupported code (e.g., XYZ) or crypto code (e.g., BTC).</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Request rejected with validation error; order not created; only the 32 supported fiat currencies accepted (crypto out of scope).</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC2-01</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC2</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC1 passing; EUR selected at checkout</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Complete checkout in EUR.&#10;2. View order confirmation.&#10;3. Re-open the order from order history/DB.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Confirmation displays EUR as the order currency; selected currency persisted on the order record and matches checkout.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC2-02</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC2</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">EUR selected at checkout</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Place order in EUR.&#10;2. Change browser locale/refresh confirmation, then reload the saved order later.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Stored currency stays EUR regardless of locale/session; does not revert to base or change on reload (no displayed-vs-persisted mismatch).</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC3-01</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC3</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">FX API up; known daily rate (e.g., 1 EUR = 1.08 base); order total 100.00 EUR</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Checkout in EUR.&#10;2. Inspect totals on checkout + confirmation.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Both amounts shown: original 100.00 EUR and converted base = 108.00 base, using the daily rate; conversion is mathematically correct.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC3-02</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC3</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Edge</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">FX API up; rate producing a non-terminating product (e.g., 33.33 x 0.8771)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Checkout with an amount/rate that needs rounding.&#10;2. Inspect converted base amount.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Converted amount rounded to base currency precision (2 dp; 0 dp for JPY-type), consistent rounding rule — no truncation, no float artifacts.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC3-03</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC3</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Base currency selected at checkout (currency == base)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Checkout choosing the base currency itself.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Converted amount equals original 1:1 (rate 1.0); no double-conversion; 'converted' line matches or is suppressed gracefully, not zero/blank.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC4-01</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC4</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">FX-failure (Positive handling)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Simulate FX API down (mock 500/timeout/no route); non-base currency selected</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Checkout in EUR with FX API unreachable.&#10;2. Place order.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Visible warning that conversion is unavailable; order still saved with original currency/amount and no converted base amount; no crash, no blocked checkout.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC4-02</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC4</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">FX-failure (Negative)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">FX API returns malformed/partial response (200 empty body or missing rate for selected currency)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Checkout in EUR.&#10;2. Place order.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Treated as unavailable -&gt; same warning + save-without-conversion path; system does not store a null/0 rate or a wrong converted amount.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC4-03</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC4</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Negative / Out-of-scope</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">FX API recovers after a no-conversion order (no historical recalc per ticket)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Place order during outage (no conversion).&#10;2. Restore FX API.&#10;3. Re-open that order.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Order is NOT retroactively converted; original-only amount preserved; warning/flag remains (historical recalculation out of scope).</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC5-01</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC5</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Completed order in EUR with successful conversion (TC-AC3-01)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Generate/download PDF receipt.&#10;2. Open the confirmation email.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">PDF and email both show original (100.00 EUR) and converted (108.00 base) amounts, with rate/date as applicable; figures match confirmation.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC5-02</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC5</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">FX-failure / Negative</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Order placed during FX outage (TC-AC4-01, no conversion)</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Generate receipt PDF + email for that order.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Receipt shows original amount only and the same conversion-unavailable notice; does not fabricate or show blank/0 converted amount.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC6-01</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC6</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Same shopper places two orders</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Order #1 in EUR.&#10;2. Start Order #2; check dropdown default.&#10;3. Select GBP for Order #2.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Order #2 does not inherit EUR; each order stores its own currency (EUR and GBP independently); dropdown defaults to base/empty, not last-used.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row><Row><Cell ss:StyleID="body"><Data ss:Type="String">TC-AC6-02</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">AC6</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">Shopper changes a later order's currency; no account-level setting exists</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">1. Place Order #1 in EUR.&#10;2. Place Order #2 in USD.&#10;3. Inspect account/profile settings and Order #1.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String">No account-level 'preferred currency' created or mutated; Order #1 stays EUR; no per-account currency field overrides per-order selection.</Data></Cell><Cell ss:StyleID="body"><Data ss:Type="String"></Data></Cell></Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>1</SplitHorizontal>
   <TopRowBottomPane>1</TopRowBottomPane>
   <ActivePane>2</ActivePane>
  </WorksheetOptions>
 </Worksheet>
</Workbook>